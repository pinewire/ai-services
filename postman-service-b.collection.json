{
  "info": {
    "name": "Service B - Triage API",
    "description": "Postman collection for the Dockerized Service B triage engine. Import this file, select the local environment, then run requests in order for the happy-path and feedback flow.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8001" },
    { "key": "triage_request_id", "value": "" },
    { "key": "refusal_request_id", "value": "" }
  ],
  "item": [
    {
      "name": "Health and Operations",
      "item": [
        {
          "name": "Healthz",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/healthz" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "pm.test('status is ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"], "type": "text/javascript" } }]
        },
        {
          "name": "Readiness",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/readyz" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "pm.test('database is ready', () => pm.expect(pm.response.json().status).to.eql('ready'));"], "type": "text/javascript" } }]
        },
        {
          "name": "Prometheus Metrics",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/metrics" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "pm.test('Prometheus output exists', () => pm.expect(pm.response.text()).to.include('service_b_triage_requests_total'));"], "type": "text/javascript" } }]
        }
      ]
    },
    {
      "name": "Triage",
      "item": [
        {
          "name": "Known VPN ticket - grounded response",
          "event": [{ "listen": "prerequest", "script": { "exec": ["pm.variables.set('triage_request_id', pm.variables.replaceIn('{{$guid}}'));"], "type": "text/javascript" } }, { "listen": "test", "script": { "exec": ["const body = pm.response.json();", "pm.test('HTTP 200', () => pm.response.to.have.status(200));", "pm.test('category is network.vpn', () => pm.expect(body.category).to.eql('network.vpn'));", "pm.test('has grounded citation', () => pm.expect(body.citations.length).to.be.above(0));", "pm.test('has request header', () => pm.expect(pm.response.headers.get('X-Request-Id')).to.eql(body.request_id));", "pm.test('confidence is bounded', () => pm.expect(body.confidence).to.be.within(0, 1));"], "type": "text/javascript" } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"request_id\": \"{{triage_request_id}}\",\n  \"ticket_ref\": \"PM-VPN-001\",\n  \"subject\": \"VPN drops after about 30 seconds\",\n  \"messages\": [{\"author_type\": \"customer\", \"body\": \"VPN connects then disconnects. Error VPN-4021.\", \"created_at\": \"2026-09-04T14:22:03Z\"}],\n  \"requester\": {\"department\": \"Finance\", \"region\": \"us-east\", \"tenure_days\": 412, \"prior_ticket_count\": 3}\n}" }, "url": "{{baseUrl}}/v1/triage" }
        },
        {
          "name": "Repeat same request - idempotency",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"request_id\": \"{{triage_request_id}}\",\n  \"ticket_ref\": \"PM-VPN-001\",\n  \"subject\": \"VPN drops after about 30 seconds\",\n  \"messages\": [{\"author_type\": \"customer\", \"body\": \"VPN connects then disconnects. Error VPN-4021.\", \"created_at\": \"2026-09-04T14:22:03Z\"}],\n  \"requester\": {\"department\": \"Finance\", \"region\": \"us-east\", \"tenure_days\": 412, \"prior_ticket_count\": 3}\n}" }, "url": "{{baseUrl}}/v1/triage" },
          "event": [{ "listen": "test", "script": { "exec": ["const body = pm.response.json();", "pm.test('HTTP 200', () => pm.response.to.have.status(200));", "pm.test('same request id returned', () => pm.expect(body.request_id).to.eql(pm.variables.get('triage_request_id')));", "pm.test('cached model response is present', () => pm.expect(body.model).to.be.a('string'));"], "type": "text/javascript" } }]
        },
        {
          "name": "Unsupported ticket - refusal path",
          "event": [{ "listen": "prerequest", "script": { "exec": ["pm.variables.set('refusal_request_id', pm.variables.replaceIn('{{$guid}}'));"], "type": "text/javascript" } }, { "listen": "test", "script": { "exec": ["const body = pm.response.json();", "pm.test('HTTP 200', () => pm.response.to.have.status(200));", "pm.test('category is other', () => pm.expect(body.category).to.eql('other'));", "pm.test('no suggested reply', () => pm.expect(body.suggested_reply).to.be.null);", "pm.test('no citations', () => pm.expect(body.citations).to.be.empty);", "pm.test('clarifying questions returned', () => pm.expect(body.clarifying_questions.length).to.be.above(0));"], "type": "text/javascript" } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"request_id\": \"{{refusal_request_id}}\",\n  \"ticket_ref\": \"PM-REFUSAL-001\",\n  \"subject\": \"Office plant needs watering\",\n  \"messages\": [{\"author_type\": \"customer\", \"body\": \"The ficus by reception looks droopy.\", \"created_at\": \"2026-09-04T14:22:03Z\"}],\n  \"requester\": {\"department\": \"Facilities\", \"region\": \"us-east\", \"tenure_days\": 20, \"prior_ticket_count\": 0}\n}" }, "url": "{{baseUrl}}/v1/triage" }
        },
        {
          "name": "Simulated overload",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"request_id\":\"{{$guid}}\",\"ticket_ref\":\"PM-FAIL-001\",\"subject\":\"VPN issue\",\"messages\":[{\"author_type\":\"customer\",\"body\":\"VPN drops\",\"created_at\":\"2026-09-04T14:22:03Z\"}],\"requester\":{\"department\":\"IT\",\"region\":\"us-east\",\"tenure_days\":1,\"prior_ticket_count\":0}}" }, "url": "{{baseUrl}}/v1/triage?fail=true" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 503', () => pm.response.to.have.status(503));", "pm.test('Retry-After is present', () => pm.expect(pm.response.headers.get('Retry-After')).to.eql('30'));", "pm.test('error is overloaded', () => pm.expect(pm.response.json().error).to.eql('overloaded'));"], "type": "text/javascript" } }]
        },
        {
          "name": "Simulated delay",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"request_id\":\"{{$guid}}\",\"ticket_ref\":\"PM-DELAY-001\",\"subject\":\"VPN issue\",\"messages\":[{\"author_type\":\"customer\",\"body\":\"VPN drops\",\"created_at\":\"2026-09-04T14:22:03Z\"}],\"requester\":{\"department\":\"IT\",\"region\":\"us-east\",\"tenure_days\":1,\"prior_ticket_count\":0}}" }, "url": "{{baseUrl}}/v1/triage?delay_ms=1000" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "pm.test('latency is reported', () => pm.expect(pm.response.json().latency_ms).to.be.at.least(900));"], "type": "text/javascript" } }]
        }
      ]
    },
    {
      "name": "Feedback",
      "item": [
        {
          "name": "Record correct feedback",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"request_id\": \"{{triage_request_id}}\",\n  \"verdict\": \"correct\"\n}" }, "url": "{{baseUrl}}/v1/feedback" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "pm.test('feedback recorded', () => pm.expect(pm.response.json().status).to.eql('recorded'));", "pm.test('run id returned', () => pm.expect(pm.response.json().run_id).to.be.a('string'));"], "type": "text/javascript" } }]
        },
        {
          "name": "Unknown feedback request - 404",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"request_id\":\"{{$guid}}\",\"verdict\":\"incorrect\",\"corrected_category\":\"network.vpn\",\"corrected_priority\":\"p2\"}" }, "url": "{{baseUrl}}/v1/feedback" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 404', () => pm.response.to.have.status(404));", "pm.test('not found error', () => pm.expect(pm.response.json().error).to.eql('not_found'));"], "type": "text/javascript" } }]
        }
      ]
    }
  ]
}
